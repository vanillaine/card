# Discord user ID shown in the profile header (via the Lanyard API).
# Not actually secret — it's fetched client-side — but kept in env for tidiness.
NEXT_PUBLIC_DISCORD_ID=388320022340173834

# TMDB v3 API key, used server-side to look up film posters/metadata for the
# Films & Books tab. Get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# IGDB (Twitch developer) credentials, used server-side to look up game
# covers for the Games tab. Create an app at https://dev.twitch.tv/console/apps
# — Client ID and Client Secret both come from there.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# FFXIV character shown in "Currently Playing" (via Lodestone). Open your character on
# https://na.finalfantasyxiv.com/lodestone/ — the number at the end of the URL is the ID.
# Leave empty to hide the FFXIV row.
FFXIV_LODESTONE_ID=

# uma.moe API key, for live Umamusume trainer stats. uma.moe issues keys for
# server-to-server use (see https://uma.moe/api/docs, community Discord: discord.uma.moe).
# Leave empty to keep the static Umamusume entry.
UMAMOE_API_KEY=

# --- admin panel (admin.vanillaine.my.id) ---------------------------------

# Postgres connection for the admin's content DB + auth sessions, from your
# Supabase project's Connect dialog → Direct connection → Connection string.
# Use the pooler variants, not "Direct connection" (that one defaults to
# IPv6-only): DATABASE_URL = Transaction pooler (used at runtime), DIRECT_URL
# = Session pooler (used for migrations — still needs session-level features
# the transaction pooler doesn't support, e.g. prepared statements).
DATABASE_URL=
DIRECT_URL=

# Random secret Better Auth uses to sign sessions. Generate one with:
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# The admin panel's own origin, e.g. https://admin.vanillaine.my.id in
# production. Locally, Google OAuth won't authorize a *.localhost subdomain
# origin, so run the admin panel with `npm run dev:admin` (a second dev
# server on port 3001, plain "localhost") and use http://localhost:3001 here.
BETTER_AUTH_URL=

# Which host proxy.ts treats as the admin panel. A bare hostname in
# production (admin.vanillaine.my.id, no protocol/port); locally, include
# the port (localhost:3001) to match `npm run dev:admin` above.
NEXT_PUBLIC_ADMIN_HOST=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Authorized JavaScript origin + redirect URI must match BETTER_AUTH_URL
# exactly (redirect URI is <BETTER_AUTH_URL>/api/auth/callback/google) — add
# both the production and http://localhost:3001 ones to the same client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The only Google account allowed into the admin panel. Anyone else who signs
# in gets an inert account row but no admin access.
OWNER_EMAIL=
